  {
    "id": 22,
    "level": "B1",
    "title": "Konjunktiv II: wishes, advice & unreal situations",
    "goals": [
      "advice",
      "hypotheticals",
      "politeness",
      "dreams"
    ],
    "grammar": [
      {
        "name": "würde + infinitive",
        "explanation": "würde + infinitive is widely used for hypothetical situations and polite statements.",
        "examples": [
          "Ich würde gern in Deutschland studieren.",
          "Was würdest du machen?",
          "Wir würden früher kommen, wenn wir könnten."
        ]
      },
      {
        "name": "common synthetic forms",
        "explanation": "wäre, hätte, könnte, müsste, dürfte, sollte and some strong verbs are preferred over würde forms.",
        "examples": [
          "Wenn ich mehr Zeit hätte, würde ich mehr lesen.",
          "An deiner Stelle würde ich warten.",
          "Das könnte funktionieren."
        ]
      }
    ],
    "vocab": [
      {
        "de": "der Wunsch",
