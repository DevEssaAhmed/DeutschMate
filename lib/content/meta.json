{
  "levels": {
    "A1": {
      "goal": "Handle simple everyday exchanges, introduce yourself, understand basic signs and messages, and build correct simple sentences."
    },
    "A2": {
      "goal": "Communicate in routine situations, narrate recent events, describe experiences, and understand common everyday texts."
    },
    "B1": {
      "goal": "Deal with most travel and work situations, narrate and explain experiences, give reasons, and write connected texts."
    },
    "B2": {
      "goal": "Understand complex texts, interact fluently on familiar professional topics, and argue with detail, precision and nuance."
    },
    "C1": {
      "goal": "Use German flexibly and effectively for academic, professional and social purposes, with strong control of register, nuance and cohesion."
    }
  },
