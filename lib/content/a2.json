  {
    "id": 14,
    "level": "A2",
    "title": "Subordinate clauses with weil, dass & wenn",
    "goals": [
      "reasons",
      "opinions",
      "plans",
      "conditions"
    ],
    "grammar": [
      {
        "name": "verb-final subordinate clauses",
        "explanation": "After subordinating conjunctions such as weil, dass, wenn, the conjugated verb moves to the end of that clause.",
        "examples": [
          "Ich lerne Deutsch, weil ich in Deutschland studieren möchte.",
          "Ich glaube, dass der Kurs gut ist.",
          "Wenn ich Zeit habe, komme ich."
        ]
      },
      {
        "name": "main clause after subordinate clause",
        "explanation": "When a subordinate clause comes first, the entire clause counts as position 1, so the main clause verb follows immediately.",
        "examples": [
          "Wenn ich frei habe, gehe ich ins Kino.",
          "Weil es regnet, bleibe ich zu Hause.",
          "Dass er kommt, freut mich."
        ]
      }
    ],
    "vocab": [
      {
        "de": "weil",
        "en": "because"
      },
      {
        "de": "dass",
        "en": "that"
      },
      {
        "de": "wenn",
        "en": "if / whenever"
