    ],
    "grammar": [
      {
        "name": "Perfekt: haben or sein",
        "explanation": "Use haben with most verbs; use sein especially with intransitive movement and changes of state. The participle usually goes to the sentence end.",
        "examples": [
          "Ich habe gestern gearbeitet.",
          "Wir sind spät angekommen.",
          "Er ist schnell eingeschlafen."
        ]
      },
      {
        "name": "past participles",
        "explanation": "Regular verbs form ge- + stem + -t. Many inseparable prefixes do not take ge-. Separable verbs insert ge between prefix and stem.",
        "examples": [
          "machen -> gemacht",
          "besuchen -> besucht",
          "einkaufen -> eingekauft"
        ]
      }
    ],
